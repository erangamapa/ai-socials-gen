generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id                   String    @id @default(cuid())
  description          String
  channels             String[]
  visualType           String    @default("background-only")
  status               String    @default("queued")
  errorMessage         String?
  retrievalBundle      Json?
  rulesVersion         Int       @default(0)
  rulesSnapshot        String?
  /// IDs of PromptRules that were active when this job was generated — used for accurate feedback attribution
  activeRuleIds        String[]  @default([])
  mode                 String    @default("socials")
  subjectReferenceUrl  String?
  subjectReferenceNote String?
  subjectReferences    Json?
  angleReference       Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  variants             Variant[]

  @@index([status, createdAt])
  @@index([mode, createdAt])
}

model Variant {
  id           String     @id @default(cuid())
  jobId        String
  label        String
  plannerSpec  Json?
  status       String     @default("pending")
  errorMessage String?
  createdAt    DateTime   @default(now())
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  artifacts    Artifact[]
  feedback     Feedback[]
}

model Artifact {
  id               String   @id @default(cuid())
  variantId        String
  channel          String
  kind             String
  url              String
  width            Int
  height           Int
  mimeType         String   @default("image/png")
  editPrompt       String?
  sourceArtifactId String?
  createdAt        DateTime @default(now())
  variant          Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  variantId String
  decision  String
  reasons   String[]
  notes     String?
  createdAt DateTime @default(now())
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([decision, createdAt])
}

model Template {
  id        String   @id @default(cuid())
  name      String
  spec      Json
  createdAt DateTime @default(now())
}

model PromptRule {
  id           String    @id @default(cuid())
  content      String
  category     String    @default("general")
  source       String    @default("manual")
  enabled      Boolean   @default(true)
  priority     Int       @default(3)
  sourceJobId  String?
  mode         String    @default("socials")
  hitCount     Int       @default(0)
  successCount Int       @default(0)
  confidence   Int       @default(80)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enabled, mode])
  @@index([mode, confidence])
  @@index([sourceJobId, mode, createdAt])
}

model AssetVaultItem {
  id             String    @id @default(cuid())
  type           String
  pathOrUrl      String
  tags           String[]
  channelHints   String[]
  notes          String?
  analysis       Json?
  analysisStatus String    @default("pending")
  analyzedAt     DateTime?
  usageScore     Int       @default(0)
  /// Per-context scores keyed by sport/topic tag, e.g. {"football": 3, "mma": -1}
  contextScores  Json?
  /// Semantic embedding vector stored as a JSON array of floats
  embedding      Json?
  createdAt      DateTime  @default(now())
}

model TemplateStats {
  id          String   @id @default(cuid())
  templateId  String
  channel     String
  jobCount    Int      @default(0)
  acceptCount Int      @default(0)
  rejectCount Int      @default(0)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([templateId, channel])
}
