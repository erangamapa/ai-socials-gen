# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Prisma Postgres (local dev via `npx prisma dev`)  OR  any hosted Postgres (Supabase / Neon / Railway)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=<YOUR_PRISMA_DEV_API_KEY>"
# Direct TCP connection used by PrismaClient at runtime
DIRECT_DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable"

# ─────────────────────────────────────────────
# BLOB STORAGE
# ─────────────────────────────────────────────
# "local" stores files in public/uploads (good for dev, assets are in git)
# "vercel" streams to Vercel Blob (recommended for production)
BLOB_STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=          # Required when BLOB_STORAGE_PROVIDER=vercel
LOCAL_BLOB_DIR=./public/uploads  # Only used when BLOB_STORAGE_PROVIDER=local

# ─────────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...    # Claude (planning + analysis)
NANO_BANANA_API_KEY=AIza...     # Google Gemini (image generation)
RECRAFT_API_KEY=...             # Recraft (remove background + vectorise)

# ─────────────────────────────────────────────
# MOCK MODE
# ─────────────────────────────────────────────
# Set to "true" to skip real AI calls and use static mock responses (useful for UI dev)
USE_MOCK_PROVIDERS=false

# ─────────────────────────────────────────────
# INNGEST (background job queue)
# ─────────────────────────────────────────────
# Local dev: run `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest`
# Production: get keys from https://app.inngest.com → your project → API keys
INNGEST_EVENT_KEY=local         # Use "local" for dev, real key for production
INNGEST_SIGNING_KEY=            # Leave empty for local dev, required for production
