# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socials_gen?sslmode=disable"

# Blob storage: "local" | "vercel-blob"
BLOB_STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
LOCAL_BLOB_DIR=./public/uploads

# AI providers (optional in MVP — mock available)
ANTHROPIC_API_KEY=
NANO_BANANA_API_KEY=

# Recraft.ai — used for vectorize and remove-bg
RECRAFT_API_KEY=

# Set to "true" to use mock AI + image providers (no API keys needed)
USE_MOCK_PROVIDERS=true

# Inngest (production only)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
