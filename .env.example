# ═══════════════════════════════════════════════════════════════════════════════
# AI Socials Gen — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# Legend:
#   [REQUIRED]  — app will not start without this
#   [OPTIONAL]  — has a sensible default or enables an optional feature
#   [PROD ONLY] — only needed in production deployments
#

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────
# The app uses PostgreSQL via Prisma ORM.
#
# Local development — use Prisma's built-in dev database:
#   1. Run `npx prisma dev` in a separate terminal (starts a local Postgres)
#   2. Use the connection strings below as-is
#
# Production — use Neon (https://neon.tech) or any PostgreSQL provider:
#   Set both to the same connection string.
#
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=your-prisma-dev-api-key"
DIRECT_DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable"

# ─────────────────────────────────────────────────────────────────────────────
# BLOB STORAGE  [OPTIONAL — defaults to local filesystem]
# ─────────────────────────────────────────────────────────────────────────────
# Controls where generated images (plates, finals, specs) are stored.
#
# Options:
#   "local"       → saves to LOCAL_BLOB_DIR (public/uploads). Good for dev.
#   "vercel-blob" → streams to Vercel Blob. Required on Vercel (filesystem is read-only).
#
# Vercel Blob setup: https://vercel.com/docs/storage/vercel-blob
#
BLOB_STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=                # [PROD ONLY] Vercel Blob read/write token from dashboard
LOCAL_BLOB_DIR=./public/uploads       # Only used when BLOB_STORAGE_PROVIDER=local

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS  [REQUIRED for real generation, OPTIONAL if using mock mode]
# ─────────────────────────────────────────────────────────────────────────────
# The app uses three AI services:
#
# 1. Anthropic Claude — creative planning, prompt enhancement, rule synthesis
#    Models used: claude-sonnet-4-20250514
#    Get a key: https://console.anthropic.com/settings/keys
#
# 2. Google Gemini — image generation (via Nano Banana / Gemini Flash)
#    Models used: gemini-2.0-flash-preview-image-generation
#    Get a key: https://aistudio.google.com/apikey
#
# 3. Recraft — background removal and SVG vectorization (optional post-processing)
#    Get a key: https://www.recraft.ai/docs
#
ANTHROPIC_API_KEY=your-anthropic-api-key
NANO_BANANA_API_KEY=your-google-gemini-api-key
RECRAFT_API_KEY=your-recraft-api-key

# ─────────────────────────────────────────────────────────────────────────────
# MOCK MODE  [OPTIONAL — defaults to false]
# ─────────────────────────────────────────────────────────────────────────────
# Set to "true" to skip all real AI calls and return static placeholder responses.
# Useful for UI development, testing, and CI without burning API credits.
# When enabled, ANTHROPIC_API_KEY and NANO_BANANA_API_KEY are not required.
#
USE_MOCK_PROVIDERS=false

# ─────────────────────────────────────────────────────────────────────────────
# PASSWORD PROTECTION  [OPTIONAL — app is open if unset]
# ─────────────────────────────────────────────────────────────────────────────
# Single shared password to gate access to the app. When set, users must
# log in at /login before accessing any page or API.
#
# IMPORTANT: Always set this in production to prevent unauthorized access
# and runaway AI costs.
#
APP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# INNGEST — Background Job Queue  [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────
# Inngest powers all background workflows (planning, image generation, etc.)
#
# Local development:
#   1. Set INNGEST_EVENT_KEY=local (below)
#   2. Leave INNGEST_SIGNING_KEY empty
#   3. Run the Inngest dev server:
#      npx inngest-cli@latest dev -u http://localhost:3000/api/inngest
#
# Production (https://app.inngest.com):
#   1. Create a project → go to API Keys
#   2. Copy Event Key and Signing Key
#
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=                  # [PROD ONLY] Required to verify webhook signatures

# ─────────────────────────────────────────────────────────────────────────────
# QUICK START (local development)
# ─────────────────────────────────────────────────────────────────────────────
# Note: Variables like VERCEL, VERCEL_ENV, VERCEL_URL, TURBO_*, NX_DAEMON
# that appear in .env.vercel are auto-injected by the Vercel platform and
# should NOT be set locally.
#
#   1. cp .env.example .env.local
#   2. Fill in ANTHROPIC_API_KEY and NANO_BANANA_API_KEY (or set USE_MOCK_PROVIDERS=true)
#   3. Terminal 1:  npx prisma dev                    (starts local Postgres)
#   4. Terminal 2:  npm run setup:local               (migrations + seed)
#   5. Terminal 3:  npm run dev                       (Next.js on port 3000)
#   6. Terminal 4:  npm run inngest:dev               (background job runner)
#   7. Open http://localhost:3000
#
